FROM python:3.12-slim AS downloader
ARG HF_TOKEN
ENV HF_HUB_DISABLE_XET=1
RUN pip install --no-cache-dir huggingface_hub[hf_xfer] && \
    HF_TOKEN=${HF_TOKEN} hf download \
      palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4 \
      --local-dir /models && \
    rm -rf /models/.cache

FROM docker.io/busybox:latest
# Split into multiple layers (~4GB each) to avoid push timeout on large single blob
COPY --from=downloader /models/model-00001-of-00006.safetensors /models/
COPY --from=downloader /models/model-00002-of-00006.safetensors /models/
COPY --from=downloader /models/model-00003-of-00006.safetensors /models/
COPY --from=downloader /models/model-00004-of-00006.safetensors /models/
COPY --from=downloader /models/model-00005-of-00006.safetensors /models/
COPY --from=downloader /models/model-00006-of-00006.safetensors /models/
COPY --from=downloader /models/mtp.safetensors /models/
# Config and tokenizer files (small)
COPY --from=downloader /models/config.json /models/model.safetensors.index.json /models/generation_config.json /models/quantize_config.json /models/preprocessor_config.json /models/processor_config.json /models/
COPY --from=downloader /models/tokenizer.json /models/tokenizer_config.json /models/merges.txt /models/chat_template.jinja /models/README.md /models/.gitattributes /models/
LABEL io.openshift.modelcar="true"
LABEL org.opencontainers.image.description="Qwen3.6-35B-A3B GPTQ-Int4 weights for OCI ModelCar"
