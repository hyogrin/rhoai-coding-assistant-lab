# ============================================================
# RHOAI Code Assistant Lab - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp sample.env .env
# ============================================================

# --- OpenShift Cluster ---
# Your cluster's apps domain (e.g., apps.cluster-abc.example.com)
CLUSTER_DOMAIN=apps.cluster.example.com

# --- RHOAI Model Serving ---
# Hugging Face token for downloading models (Qwen, Llama, etc.)
HF_TOKEN=hf_your-huggingface-token-here
HF_TOKEN_SECRET=hf-token

# --- Model Endpoints (Direct Route) ---
# MODEL_ENDPOINT=https://qwen36-35b-a3b-rhoai-models.<CLUSTER_DOMAIN>
# MODEL_NAME=qwen36-35b-a3b

# --- MaaS (Models as a Service) ---
# API key generated via RHOAI Dashboard or MaaS API
# Generate via: POST https://maas.<CLUSTER_DOMAIN>/maas-api/v1/api-keys
# MAAS_API_KEY=sk-oai-your-maas-api-key
