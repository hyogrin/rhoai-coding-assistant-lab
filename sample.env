# ============================================================
# RHOAI Code Assistant Lab - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp sample.env .env
# ============================================================

# --- OpenShift Cluster ---
# Your cluster's apps domain (e.g., apps.cluster-abc.example.com)
CLUSTER_DOMAIN=apps.cluster.example.com

# --- RHOAI Model Serving ---
# Hugging Face token for downloading models (Qwen, Llama, etc.)
HF_TOKEN=hf_your-huggingface-token-here
HF_TOKEN_SECRET=hf-token

# --- Model Endpoints ---
# MaaS Gateway endpoint (LLMInferenceService / llm-d deployment)
MODEL_ENDPOINT=https://maas-api.<CLUSTER_DOMAIN>/<MODEL_NAMESPACE>/<MODEL_NAME>
MODEL_NAME=qwen36-27b
MODEL_NAMESPACE=demo

# --- MaaS (Models as a Service) ---
# API key generated via RHOAI Dashboard or MaaS API
# Generate via: POST https://maas.<CLUSTER_DOMAIN>/maas-api/v1/api-keys
# MAAS_API_KEY=sk-oai-your-maas-api-key

# --- PostgreSQL for MaaS ---
# MaaS API requires PostgreSQL 14+ for API key storage.
# If you already have a PostgreSQL instance, set the connection URL below
# and the notebook will skip installation.
# If left empty, the notebook will deploy PostgreSQL in-cluster automatically.
# MAAS_DB_CONNECTION_URL=postgresql://maas:password@hostname:5432/maas?sslmode=require
