# ============================================================
# RHOAI Code Assistant Lab - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp sample.env .env
# ============================================================

# --- OpenShift Cluster ---
# Your cluster's apps domain (e.g., apps.cluster-abc.example.com)
CLUSTER_DOMAIN=apps.cluster.example.com

# --- RHOAI Model Serving ---
# Hugging Face token for downloading models (Qwen, Llama, etc.)
HF_TOKEN=hf_your-huggingface-token-here
HF_TOKEN_SECRET=hf-token

# --- Model Endpoints ---
# MaaS Gateway endpoint (auto-constructed if CLUSTER_DOMAIN is set)
# MODEL_ENDPOINT=https://maas-api.apps.cluster.example.com/demo/qwen36-27b
MODEL_NAME=qwen36-27b
MODEL_NAMESPACE=demo

# Optional: specify which model to deploy in 0_setup (auto-detected if omitted)
# DEPLOY_MODEL=qwen36-27b

# --- MaaS (Models as a Service) ---
# API key generated via RHOAI Dashboard or MaaS API (Phase 2)
# Generated by: 2_maas/2_enable_maas.ipynb — leave empty until then
# MAAS_API_KEY=sk-oai-your-maas-api-key

