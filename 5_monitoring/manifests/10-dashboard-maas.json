{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Token Consumption by Subscription (tok/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(authorized_hits[5m])) by (limitador_namespace) * 60",
          "legendFormat": "{{limitador_namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "tok/min" }
      }
    },
    {
      "title": "Request Rate by Subscription (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(authorized_calls[5m])) by (limitador_namespace)",
          "legendFormat": "{{limitador_namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "Rate-Limited Requests (429)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(limited_calls[5m])) by (limitador_namespace) * 60",
          "legendFormat": "{{limitador_namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "rpm" }
      }
    },
    {
      "title": "Auth Evaluations (Authorino)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(auth_server_evaluations_total[5m])) by (authconfig)",
          "legendFormat": "{{authconfig}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "Total Tokens Consumed (1h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(authorized_hits[1h]))",
          "legendFormat": "Tokens (1h)"
        }
      ]
    },
    {
      "title": "Total Requests (1h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(authorized_calls[1h]))",
          "legendFormat": "Requests (1h)"
        }
      ]
    },
    {
      "title": "Rate-Limited Total (1h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(limited_calls[1h]))",
          "legendFormat": "429 (1h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "title": "Limitador Health",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "limitador_up",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Token Usage Breakdown by Subscription (1h)",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 22 },
      "targets": [
        {
          "expr": "sum(increase(authorized_hits[1h])) by (limitador_namespace)",
          "legendFormat": "{{limitador_namespace}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["maas", "limitador", "authorino", "usage"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "MaaS Usage (Token Consumption)",
  "uid": "maas-usage-metrics"
}
